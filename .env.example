# Copy to .env and fill in. Everything here is optional except the key for live mode.
ANTHROPIC_API_KEY=

# "live" calls Claude Haiku; "mock" runs the whole simulation with canned lines for $0.
LLM_MODE=live

# Hard stop: the simulation pauses when today's spend (real calendar day) reaches this.
DAILY_BUDGET_USD=2.00

# Where the brewery is. Drives the daily news search and local flavor.
BREWERY_CITY=Minneapolis, MN

# Sim minutes per real minute (adjustable live in the UI).
SIM_SPEED=15

# New people who walk in (generated on the fly): roughly how many a week, and the most patrons in total.
NEWCOMERS_ENABLED=true
NEWCOMERS_PER_WEEK=8
MAX_PATRONS=150

WEB_SEARCH_ENABLED=true
MAX_CONCURRENT_LLM=3

# Postgres: docker compose creates the database with these and the backend connects with them.
POSTGRES_USER=modist
POSTGRES_PASSWORD=modist
POSTGRES_DB=modist
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
